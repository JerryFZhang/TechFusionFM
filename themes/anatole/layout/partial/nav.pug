.page-top.animated.fadeInDown
  .nav
    li
      a(href="/")= __('Home')
    li
      a(class=is_current('/categories/spotlight/') ? 'current' : null, href="/categories/spotlight/")= __('Spotlight')
    li
      a(class=is_current('/categories/gadgets/') ? 'current' : null, href="/categories/gadgets/")= __('Gadgets')
    li
      a(class=is_current('/faq/') ? 'current' : null, href="/faq/")= __('FAQ')
    li
      a(href="mailto:" + ((theme.social && theme.social.email) || 'hi@TechFusionFM.com'))= __('Email')
    li
      a(class=is_current('/donate/') ? 'current' : null, href="/donate/")= __('Donate')
