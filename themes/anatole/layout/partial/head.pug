- var siteUrl = String(config.url).replace(/\/+$/, '');
- var absUrl = function (p) { return /^https?:\/\//.test(p) ? p : siteUrl + url_for(p); };
- var excerpt = function (html) { return strip_html(html || '').replace(/^\s+/, '').replace(/\s+$/, '').replace(/\s+/g, ' ').substring(0, 150); };
- var isArticle = is_post();
- var isPage = page.layout === 'page';
- var metaDesc = config.description;
- if (page.subtitle) metaDesc = excerpt(page.subtitle);
- else if (page.desc) metaDesc = page.desc;
- else if ((isArticle || isPage) && page.content) metaDesc = excerpt(page.content);
- else if (page.archive) metaDesc = '归档页面 - ' + config.title;
- else if (page.tag) metaDesc = '标签：' + page.tag + ' - ' + config.title;
- else if (page.category && show.description) metaDesc = show.description;
- var ogTitle = config.title;
- if (isArticle || isPage) ogTitle = page.title;
- else if (page.category && showKey !== 'podcast') ogTitle = show.title + (show.subtitle ? '（' + show.subtitle + '）' : '');
- var canonical = absUrl(page.path || '').replace(/index\.html$/, '');
- var social = theme.social || {};
meta(charset="utf-8")
meta(http-equiv="X-UA-Compatible", content="IE=edge")
meta(name="author", content= theme.author)
title
    block site_title
        = config.title
meta(name="description", content= metaDesc)

if page.keywords
    meta(name="keywords", content= page.keywords)
else
    meta(name="keywords" content= theme.keywords)

meta(name="viewport", content="width=device-width, initial-scale=1.0")
meta(name="apple-mobile-web-app-capable", content="yes")
meta(name="apple-mobile-web-app-status-bar-style", content="black")
meta(name="apple-mobile-web-app-title", content="科技聚变")
meta(name="format-detection", content="telephone=no")
meta(name="renderer", content="webkit")
if !/(^|\/)404\.html$/.test(page.path || '')
    link(rel="canonical", href= canonical)

//- Open Graph / Twitter
meta(property="og:site_name", content= config.title)
meta(property="og:type", content= isArticle ? 'article' : 'website')
meta(property="og:title", content= ogTitle)
meta(property="og:description", content= metaDesc)
meta(property="og:url", content= canonical)
meta(property="og:image", content= absUrl(show.logo))
meta(property="og:image:alt", content= show.alt)
meta(property="og:locale", content="zh_CN")
if isArticle
    meta(property="article:published_time", content= page.date.toISOString())
meta(name="twitter:card", content="summary")
if social.x
    meta(name="twitter:site", content="@" + social.x)
meta(name="twitter:title", content= ogTitle)
meta(name="twitter:description", content= metaDesc)
meta(name="twitter:image", content= absUrl(show.logo))

link(rel="icon", href="/images/favicon.png", type="image/png")
link(rel="stylesheet", href= url_for('css/style.css'))
link(rel="stylesheet", href= url_for('css/blog_basic.css'))
link(rel="stylesheet", href= url_for('css/font-awesome.min.css'))
each pc in (config.podcasts || [])
    if pc.feed && pc.feed.path
        link(rel="alternate", type="application/rss+xml", title= pc.feed.title, href= url_for(pc.feed.path))
link(rel="apple-touch-icon", href="/images/favicon.png")
link(rel="apple-touch-icon", sizes="152x152", href="/images/favicon.png")
link(rel="apple-touch-icon", sizes="180x180", href="/images/favicon.png")
link(rel="apple-touch-icon", sizes="167x167", href="/images/favicon.png")
link(rel="apple-touch-startup-image", href="/images/favicon.png")
link(rel="mask-icon", href="/images/logo-no-text.svg", color="black")
