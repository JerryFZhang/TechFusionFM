//- Subscribe sidebar, driven by theme.shows[showKey] and theme.social.
//- `show` / `showKey` are set by partial/show.pug (included in layout.pug).
- var linkClass = showKey === 'podcast' ? null : showKey;
- var social = theme.social || {};
- var showLinks = show.links || {};
//- [key, Font Awesome 4.2 icon class (or null), label]
- var podcastLinkDefs = [['apple', 'fa-apple', 'Apple Podcasts'], ['xiaoyuzhou', null, '小宇宙'], ['spotify', 'fa-spotify', 'Spotify'], ['youtube_music', 'fa-youtube-play', 'YouTube Music'], ['amazon', null, 'Amazon Music'], ['pocketcasts', null, 'Pocket Casts'], ['overcast', null, 'Overcast'], ['ximalaya', null, '喜马拉雅'], ['netease', null, '网易云音乐'], ['lizhi', null, '荔枝']];
- var socialLinks = [];
- if (social.email) socialLinks.push(['mailto:' + social.email, 'fa-envelope', 'Email']);
- if (social.x) socialLinks.push(['https://x.com/' + social.x, 'fa-twitter', 'X']);
- if (social.instagram) socialLinks.push(['https://instagram.com/' + social.instagram, 'fa-instagram', 'Instagram']);
- if (social.weibo) socialLinks.push(['https://weibo.com/' + social.weibo, 'fa-weibo', '微博']);
- if (social.telegram) socialLinks.push(['https://t.me/' + social.telegram, 'fa-paper-plane', 'Telegram']);
- if (social.bluesky) socialLinks.push(['https://bsky.app/profile/' + social.bluesky, null, 'Bluesky']);
- if (social.bilibili) socialLinks.push(['https://space.bilibili.com/' + social.bilibili, null, 'B站']);
- if (social.wechat_qr) socialLinks.push([url_for(social.wechat_qr), 'fa-wechat', '微信']);

mixin sidebarLink(href, icon, label)
  li
    a(class=linkClass, href=href, title=label, aria-label=label)
      if icon
        i.fa(class=icon)
      else
        = label

.sidebar.animated.fadeInDown(class=linkClass)
  .logo-title
    .title
      img(src= url_for(show.logo), alt= show.alt)
      h3(title="")
        a(class=linkClass, href= url_for(show.home))= show.title
        if show.subtitle
          p
          small= show.subtitle
      if show.description
        .description
          p= show.description

  ul.social-links
    each s in socialLinks
      +sidebarLink(s[0], s[1], s[2])
    each d in podcastLinkDefs
      if showLinks[d[0]]
        +sidebarLink(showLinks[d[0]], d[1], d[2])
    if show.feed
      +sidebarLink(url_for(show.feed), 'fa-rss', 'RSS')
  include footer
